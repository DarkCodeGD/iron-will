[Desktop Entry]
Type=Application
Name=Iron Will
GenericName=Audio Visualizer & Session Sounds
Comment=Customize the desktop audio visualizer and session sounds
Exec=@BIN_DIR@/iron-will-settings
Icon=@APP_DIR@/iron_will/assets/iron-will.svg
Terminal=false
Categories=AudioVideo;Audio;Settings;Qt;
Keywords=visualizer;cava;sound;login;audio;spectrum;
StartupWMClass=iron-will-settings
Actions=stop-sound;play-sound;

# Right-click the launcher entry, or bind a key in System Settings → Keyboard →
# Shortcuts → Add New → Application → Iron Will.
[Desktop Action stop-sound]
Name=Stop session sound
Icon=media-playback-stop
Exec=@BIN_DIR@/iron-will-audio --stop

[Desktop Action play-sound]
Name=Play a random session sound
Icon=media-playback-start
Exec=@BIN_DIR@/iron-will-audio --play
